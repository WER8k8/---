# =============================================================================
# seo-backend 环境变量示例（复制为 .env 后修改实际值）
# =============================================================================

# ── 主应用数据库（矩阵业务库）──
DB_DIALECT=sqlite
# DB_DIALECT=mysql 时使用下列项
DB_HOST=localhost
DB_PORT=3306
DB_NAME=seo_matrix_db
DB_USER=root
DB_PASSWORD=

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT（两密钥职责不同；若同时配置则禁止相同，否则进程拒绝启动）──
# JWT_SECRET — 仅用于矩阵本机 refresh / 历史 Node Token（payload.id）
# 要求：非空，长度 ≥32
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MAIN_ADMIN_JWT_SECRET — 必须与 Python 主后端 JWT_SECRET_KEY 完全一致，
# 用于校验统一管理员登录签发的 Bearer（payload.sub + mid）
# 生产环境必填。严禁与 JWT_SECRET 相同。
MAIN_ADMIN_JWT_SECRET=

JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── 统一管理员登录页 ──
# 生产环境必填：完整绝对 URL，例如 https://admin.youdingjiancai.com/login
UNIFIED_ADMIN_LOGIN_URL=http://localhost:5173/login

# ── 矩阵库第二连接（MySQL，可选）──
# 规则：要么不配置，要么同时配置 HOST + NAME + USER
SEO_MATRIX_DB_HOST=
SEO_MATRIX_DB_PORT=3306
SEO_MATRIX_DB_USER=
SEO_MATRIX_DB_PASSWORD=
SEO_MATRIX_DB_NAME=

# ── AI ──
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1

# ── 服务 ──
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# ── 限流 ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
