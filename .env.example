# ── 前端配置（Nuxt.js 开发环境）──
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:5173

# ── 后端配置 ──
ENVIRONMENT=development
DEBUG=true

# ── 数据库配置 ──
DATABASE_URL=postgresql://youding_admin:${DB_PASSWORD}@localhost:5432/youding_prod
DB_TYPE=postgresql
DB_PASSWORD=your_secure_password_here

# ── RLS 试点（默认关闭；开启前置条件见 backend/.env.example 同名段落）──
# RLS_PILOT_ENABLED=false
# RLS_PILOT_TABLES=

# ── Redis配置 ──
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ── AI配置：DeepSeek V4 Pro（成本优化，优先使用）──
AI_DEEPSEEK_API_KEY=your_deepseek_api_key_here  # ← 填入您的DeepSeek API Key
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AI_DEEPSEEK_MODELS 在config.py中配置

# ── AI配置：Anthropic Claude（高质量任务）──
AI_ANTHROPIC_API_KEY=your_anthropic_api_key_here  # ← 可选：Claude API Key
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── AI配置：NVIDIA（备用）──
AI_NVIDIA_API_KEY=your_nvidia_api_key_here  # ← 可选：NVIDIA API Key
AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── AI配置：OpenAI（备用）──
AI_OPENAI_API_KEY=your_openai_api_key_here
AI_OPENAI_BASE_URL=https://api.openai.com/v1

# ── MinIO配置（文件存储）──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_SECURE=false

# ── CORS配置 ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ── 日志配置 ──
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
# ── 本地开发（推荐覆盖上方生产默认值）──
# cp .env.example backend/.env 后取消注释：
# ENVIRONMENT=development
# DATABASE_URL=sqlite:///./youding_dev.db
# REDIS_ENABLED=false
# MVP_LAUNCH=1

# ── O-1 Owner · HTTPS 演示域（MOD-01 / COMM-ARCH-01）──
# 送检/七步录屏公网 URL；DNS A 记录指向 staging 服务器后填写
DEMO_HTTPS_DOMAIN=demo.yourdomain.com
# ACME 签发后自动写入（scripts/pilot-acme-ssl-issue.ps1）
# DEMO_HTTPS_CERT_PATH=/etc/letsencrypt/live/demo.yourdomain.com/fullchain.pem

# ── O-2 Owner · 询盘 IM / 企微（MOD-02 / COMM-P1-01）──
# 企业微信自建应用（生产推送 5a/5b/5c 截图验收）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
# 询盘 Webhook 签名（与 IM 路由共用）
INQUIRY_WEBHOOK_SECRET=
SOCIAL_INTERACTION_WEBHOOK_SECRET=
# 抖音开放平台（ITER-03b 真实拉评 Worker · 至少拉 1 条评论）
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
# AiToEarn 评论拉取（生产实拉 1 条 · ITER-03b）
AITOEARN_API_KEY=
AITOEARN_API_BASE=https://mcp.aitoearn.cn
# 可选：SAU 导出 Inbox 目录（无 AiToEarn 时运维手工导入）
DOUYIN_COMMENT_INBOX_DIR=

# ── 视频工厂 Sidecar（planGate · media_factory）──
# 未部署时租户见 /client/plan-gate?feature=media_factory，不会假成功
LIBRETRANSLATE_BASE_URL=
VOZO_API_KEY=
PYVIDEOTRANS_BASE_URL=
MVP_LAUNCH=1

# 生产环境必须设置且长度 >= 32，可用: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars_here

# ── Docker Compose 可选配置 ──
# 监控面板（Grafana，docker-compose --profile monitoring up）
GRAFANA_PASSWORD=your_grafana_admin_password
# 数据库自动备份保留天数（docker-compose --profile backup up）
BACKUP_RETENTION_DAYS=30

# ── 外部服务（可选，按需配置）──
# Mem0 长期记忆 API
MEM0_API_URL=
# PostHog 事件埋点
POSTHOG_API_KEY=
POSTHOG_HOST=
# DeerFlow 旁路调度
DEERFLOW_SIDECAR_URL=

# ── Claude Code MCP 集成 ──
# GitHub（代码仓库操作）
GITHUB_TOKEN=your_github_personal_access_token
# Firecrawl（网页抓取 / GEO 探测）
FIRECRAWL_API_KEY=your_firecrawl_api_key
# Apollo.io（B2B 买家数据 / 外贸获客）
APOLLO_API_KEY=your_apollo_api_key
# Apify（竞品爬虫 / 电商数据采集）
APIFY_TOKEN=your_apify_token
# Clay（数据增强 / 线索充实）
CLAY_API_KEY=your_clay_api_key
# SimilarWeb（网站流量分析 / 竞品流量来源）
SIMILARWEB_API_KEY=your_similarweb_api_key
# Semrush（关键词研究 / 反链分析 / SEO 策略）
SEMRUSH_API_KEY=your_semrush_api_key
# Stitch（UI 设计生成，已有密钥则填入）
STITCH_API_KEY=AQ.Ab8RN6IZI0NZNSIGsCU9e-M8DQrnWze1kvuseGG7f29KxJqRkg

# ── 数据采集 / 行为分析 Sidecar（外置 Worker，见 deploy/docs/*-SIDECAR-DEPLOY.md）──
AI_FIND_CUSTOMER_URL=
AI_FIND_CUSTOMER_TOKEN=
# 开发可选：指向薄适配层 http://127.0.0.1:8092（需另部署 AI_Find_Customer 上游）
# AI_FIND_CUSTOMER_URL=http://127.0.0.1:8092
# AI_FIND_CUSTOMER_TOKEN=dev-sidecar-token
# AI_HUNTER_UPSTREAM_URL=http://127.0.0.1:8080
HEADLESS_PROBE_SIDECAR_URL=
HEADLESS_PROBE_SIDECAR_TOKEN=
HEADLESS_PROBE_ALLOW_STUB=0
ECOMMERCE_CRAWLERS_URL=
ECOMMERCE_CRAWLERS_TOKEN=
ECOMMERCE_SOCIAL_SPIDERS_ENABLED=0
USER_ACTION_ANALYTICS_URL=
USER_ACTION_ANALYTICS_TOKEN=
USER_ACTION_ANALYTICS_ALLOW_STUB=0
