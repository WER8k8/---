# 复制为 .env.development.local 后按本机情况改（该文件已被 gitignore）

# 后端代理目标（vite.config 读取，默认 http://127.0.0.1:8000）
VITE_PROXY_TARGET=http://127.0.0.1:8001

# 附属执行台 iframe 地址（键名必须带 VITE_ 前缀，见 src/constants/annexModules.ts）
# 留空或注释掉 = 对应执行台页显示「未部署」降级提示
# TradeAI 前端（_external/trade-ai-agent）vite 默认端口是 3000，与优丁官网实跑端口冲突，
# 启用前需先把 TradeAI 改到空闲端口再填这里。
VITE_TRADEAI_EMBED_URL=
VITE_GOODJOB_EMBED_URL=http://127.0.0.1:5188/
