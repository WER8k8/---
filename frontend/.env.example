# ── 前端配置（Nuxt.js）──
# API 基础路径（代理到后端）
NUXT_PUBLIC_API_BASE=/api/v1
# 站点 URL（建材企业官网 Nuxt，默认 :3000）
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# API 主机地址（SSR 端渲染时直接调用，须与 backend 一致）
API_HOST=http://127.0.0.1:8001
# SaaS 主域名
SAAS_PRIMARY_DOMAIN=youding-saas.com
# 租户站埋点：租户 UUID（与后台租户一致，否则看板无归属）
NUXT_PUBLIC_TENANT_ID=
# 商户 ID（与 DEFAULT_MERCHANT_ID 二选一，用于解析租户）
DEFAULT_MERCHANT_ID=1
NUXT_PUBLIC_MERCHANT_ID=
# 代理节点 ID（代理流量子树汇总，可选）
NUXT_PUBLIC_AGENT_NODE_ID=
# 统一管理后台登录页 URL（SaaS /platform 页跳转注册登录用；本地示例）
# NUXT_PUBLIC_UNIFIED_ADMIN_LOGIN_URL=http://127.0.0.1:5173/login
NUXT_PUBLIC_UNIFIED_ADMIN_LOGIN_URL=

# Google Analytics 4 Measurement ID（G-XXXXXXXXX），留空则不加载 GA4
NUXT_PUBLIC_GA4_MEASUREMENT_ID=
