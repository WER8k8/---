# ================ 环境配置文件 ================
# 根目录配置文件（敏感信息）
.env
.env.local
.env.production
.env.staging

# config/ 目录下的敏感配置
config/.env.prod
config/.env.local

# 分环境子目录下的真实 .env（含密钥，禁止入库）
config/prod/.env
config/test/.env
config/dev/.env

# 保留示例配置文件（不排除）
!config/.env.dev
!config/.env.test
!config/.env.prod.example
!config/prod/.env.example
!config/test/.env.example
!config/dev/.env.example

