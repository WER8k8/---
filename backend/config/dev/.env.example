# =============================================================================
# 开发环境配置示例 — 真实使用请复制为 .env 并填入/覆盖下列密钥
# ⚠️ .env 已在 .gitignore 中,不要提交。生产请走 Secrets Manager 注入。
# =============================================================================

# 环境标识
ENVIRONMENT=development
DEBUG=true
PORT=8080
HOST=0.0.0.0
SITE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api/v1

# 数据库 — dev 用 SQLite,生产切 postgres(下例)
DB_TYPE=sqlite
# DB_TYPE=postgresql
# DATABASE_URL=postgresql+asyncpg://youding:STRONG_PASSWORD@postgres:5432/youding
DATABASE_URL=sqlite:///./data/dev.db

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# JWT — 启动期自动检测:
#   1) 若未设置 SECRET_KEY/JWT_SECRET_KEY,代码会用 secrets.token_urlsafe(64) 生成并
#      写入 logs/auto-secret-{env}.txt(仅 dev 一次性便利)。
#   2) 生产必须在 Secrets Manager 注入强随机,不要使用 .env 中的占位值。
SECRET_KEY=__SET_VIA_SECRETS_MANAGER_OR_DEV_BOOTSTRAP__
JWT_SECRET_KEY=__SET_VIA_SECRETS_MANAGER_OR_DEV_BOOTSTRAP__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI 服务 — 所有 key 必须经 Secrets Manager 注入
# dev 允许本地占位(空字符串),生产留空并在部署平台注入
AI_OPENAI_API_KEY=
# 中文片出海 · 讯飞录音文件转写大模型（APPID + APIKey + APISecret）
XFYUN_LFASR_APP_ID=
XFYUN_LFASR_API_KEY=
XFYUN_LFASR_SECRET_KEY=
# XFYUN_LFASR_PREFERRED=0 可改回「本地 Whisper 优先」
# XFYUN_LFASR_ENABLED=0 完全关闭讯飞听写
AI_ANTHROPIC_API_KEY=
AI_GEMINI_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_NVIDIA_API_KEY=
AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_NVIDIA_COSMOS_BASE_URL=
MEDIA_FACTORY_MOCK_RENDER=true
MEDIA_FACTORY_AI_WRITE_TIMEOUT=8
MEDIA_FACTORY_AUTO_RENDER=true
MEDIA_RETENTION_HOURS=72
MEDIA_HANDOFF_DELETE_HOURS=1
MEDIA_CLEANUP_SCHEDULER_ENABLED=true
MEDIA_CLEANUP_INTERVAL_MINUTES=15

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_NOTIFICATION_ENABLED=false

# 安全配置
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_MB=50

# CORS — 逗号分隔,生产请包含 https://youding.com 与 https://youding-saas.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,https://youding.com,https://youding-saas.com

# 邮件
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# OAuth — dev 可临时 true(无凭据登录),生产必须 false
OAUTH_REDIRECT_URI=http://localhost:5173/login/oauth-callback
OAUTH_DEV_BYPASS=true

# 创始人配置
FOUNDER_WECHAT_BIND_KEY=admin
FOUNDER_ADMIN_USERNAME=admin
EXPORT_PLATFORM_FOUNDER_ONLY=false

# 视频外站真发 — Hermes 多 Worker 编排
SAU_ENABLED=true
SAU_ACCOUNT_PREFIX=youding
SAU_BILIBILI_TID=249
# SAU_CLI_PATH=C:\Users\you\social-auto-upload\.venv\Scripts\sau.exe
# SAU_HOME=C:\Users\you\.sau-home
# SAU_SIDECAR_URL=http://127.0.0.1:9910
# PUBLISH_RESULT_NOTIFY_ENABLED=true
# PUBLISH_RESULT_WEBHOOK_URL=
BILIUP_ENABLED=true
XHS_MCP_ENABLED=false
PUBLISH_WORKER_TIMEOUT_SEC=900
PUBLISH_DUAL_LINE_REQUIRED=false
AITOEARN_API_BASE=https://mcp.aitoearn.cn
AITOEARN_API_KEY=__SET_VIA_SECRETS_MANAGER__

# 七步⑤ 本地彩排
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_AGENT_SECRET=
# WECOM_PUSH_TO_USERIDS=

# ═══════════════════════════════════════════════════════════════
# 微信支付 (WeChat Pay V3) — Native 扫码支付
# ═══════════════════════════════════════════════════════════════
# 申请: https://pay.weixin.qq.com → 产品中心 → Native 支付
# 开发可用 mock 模式 (PAYMENT_ALLOW_MOCK=1)，无需真实商户号
# ═══════════════════════════════════════════════════════════════
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=__SET_VIA_SECRETS_MANAGER__
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=__SET_VIA_SECRETS_MANAGER__
# WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=
PAYMENT_ALLOW_MOCK=1

# AI_Find_Customer 找客 Sidecar（可选 · scripts/start-p6-sidecars-dev.ps1）
# AI_FIND_CUSTOMER_URL=http://127.0.0.1:8092
# AI_FIND_CUSTOMER_TOKEN=dev-sidecar-token
# AI_HUNTER_UPSTREAM_URL=http://127.0.0.1:8080
# AI_FIND_CUSTOMER_ALLOW_DEV_STUB=1

# Domain email enrichment Sidecar（可选 P2）
# DOMAIN_EMAIL_EXTRACTOR_URL=http://127.0.0.1:8093
# DOMAIN_EMAIL_EXTRACTOR_TOKEN=dev-sidecar-token
# DOMAIN_EMAIL_EXTRACTOR_ALLOW_DEV_STUB=1

# MediaCrawler Sidecar（可选 P2 · social_restricted）
# MEDIA_CRAWLER_URL=http://127.0.0.1:8094
# MEDIA_CRAWLER_TOKEN=dev-sidecar-token
# MEDIA_CRAWLER_ALLOW_DEV_STUB=1
# ECOMMERCE_SOCIAL_SPIDERS_ENABLED=1
# ECOMMERCE_SPIDER_ENABLE_MEDIA_FACEBOOK=1

# LinkedIn decision-maker Sidecar（可选 P3）
# LINKEDIN_DECISION_MAKER_URL=http://127.0.0.1:8095
# LINKEDIN_DECISION_MAKER_TOKEN=dev-sidecar-token
# LINKEDIN_DECISION_MAKER_ALLOW_DEV_STUB=1

# CustomsDataSpider Sidecar（可选 P4）
# CUSTOMS_DATA_SPIDER_URL=http://127.0.0.1:8096
# CUSTOMS_DATA_SPIDER_TOKEN=dev-sidecar-token
# CUSTOMS_DATA_SPIDER_ALLOW_DEV_STUB=1

# IMAP read-only inquiry Sidecar（可选 P5）
# IMAP_INQUIRY_URL=http://127.0.0.1:8097
# IMAP_INQUIRY_TOKEN=dev-sidecar-token
# IMAP_INQUIRY_ALLOW_DEV_STUB=1

# LibreTranslate Sidecar（可选 P6）
# LIBRETRANSLATE_URL=http://127.0.0.1:8098
# LIBRETRANSLATE_TOKEN=dev-sidecar-token
# LIBRETRANSLATE_ALLOW_DEV_STUB=1

# -----------------------------------------------------------------------------
# 本地/侧车服务地址（均为 app/core/config.py 的 Settings 默认值，可在此覆盖）
# 若本机这些端口被占用或部署在多机，请统一下方地址，避免散落在代码里。
# -----------------------------------------------------------------------------
# 小红书 MCP 本地网关
# XHS_MCP_BASE_URL=http://127.0.0.1:18060
# Hermes Site Patrol 自检服务
# HERMES_SITE_PATROL_HTTP_SELF_URL=http://127.0.0.1:8001
# 本地 Ollama 服务（Hermes Agency 默认模型 llama3.1）
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# 跨境公共资源侧车（拉取 /uploads 视频用）
# CROSS_BORDER_PUBLIC_BASE_URL=http://127.0.0.1:8001
