# =============================================================================
# 测试环境配置示例
# =============================================================================

# 环境标识
ENVIRONMENT=testing
DEBUG=false
PORT=8081
HOST=0.0.0.0
SITE_URL=http://test.youding.com
FRONTEND_URL=http://test.youding.com/admin
API_PREFIX=/api/v1

# 数据库
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/test.db

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/2

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=testuser
MINIO_SECRET_KEY=testsecret
MINIO_SECURE=false

# JWT
SECRET_KEY=test-secret-key-for-testing-environment-only
JWT_SECRET_KEY=test-secret-key-for-testing-environment-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1

# AI服务
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_GEMINI_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_NVIDIA_API_KEY=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_NOTIFICATION_ENABLED=false

# 安全配置
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_MB=20

# CORS
CORS_ORIGINS=["http://test.youding.com","http://test.youding.com/admin"]

# OAuth
OAUTH_REDIRECT_URI=http://test.youding.com/admin/login/oauth-callback
OAUTH_DEV_BYPASS=false

# 创始人配置
FOUNDER_WECHAT_BIND_KEY=test_admin
FOUNDER_ADMIN_USERNAME=test_admin
EXPORT_PLATFORM_FOUNDER_ONLY=false