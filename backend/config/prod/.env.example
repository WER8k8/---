# =============================================================================
# 生产环境配置示例
# 复制为 .env 后填写真实敏感信息
# 敏感信息由运维人员手动配置，不纳入版本控制
# =============================================================================

# 环境标识
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0
SITE_URL=https://www.youding.com
FRONTEND_URL=https://www.youding.com/admin
API_PREFIX=/api/v1

# 数据库
DB_TYPE=postgresql
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Redis
REDIS_ENABLED=true
REDIS_HOST=REDIS_HOST
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=REDIS_PASSWORD
REDIS_URL=redis://:REDIS_PASSWORD@REDIS_HOST:6379/0

# MinIO
MINIO_ENDPOINT=MINIO_ENDPOINT
MINIO_ACCESS_KEY=MINIO_ACCESS_KEY
MINIO_SECRET_KEY=MINIO_SECRET_KEY
MINIO_SECURE=true

# JWT（生产必须使用强随机密钥，生成命令: python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=JWT_SECRET_KEY
JWT_SECRET_KEY=JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI服务
AI_OPENAI_API_KEY=AI_OPENAI_API_KEY
AI_ANTHROPIC_API_KEY=AI_ANTHROPIC_API_KEY
AI_DEEPSEEK_API_KEY=AI_DEEPSEEK_API_KEY
AI_NVIDIA_API_KEY=AI_NVIDIA_API_KEY
# 英伟达免费通道模型探测：ENVIRONMENT=production 时自动开启（1:00/12:00/20:00 北京时间），部署后约 20 秒首探
# 关闭调度：NVIDIA_CUSTOMER_PROBE_SCHEDULER_ENABLED=false

# Celery
CELERY_BROKER_URL=redis://:REDIS_PASSWORD@REDIS_HOST:6379/1
CELERY_RESULT_BACKEND=redis://:REDIS_PASSWORD@REDIS_HOST:6379/1

# 飞书
FEISHU_APP_ID=FEISHU_APP_ID
FEISHU_APP_SECRET=FEISHU_APP_SECRET
FEISHU_VERIFICATION_TOKEN=FEISHU_VERIFICATION_TOKEN
FEISHU_EVENT_ENCRYPT_KEY=FEISHU_EVENT_ENCRYPT_KEY
FEISHU_NOTIFICATION_ENABLED=true

# 安全配置
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=["https://www.youding.com","https://youding-saas.com"]

# 邮件服务
SMTP_SERVER=SMTP_SERVER
SMTP_PORT=587
SMTP_USERNAME=SMTP_USERNAME
SMTP_PASSWORD=SMTP_PASSWORD
FROM_EMAIL=noreply@youding.com

# OAuth
OAUTH_REDIRECT_URI=https://www.youding.com/admin/login/oauth-callback
OAUTH_DEV_BYPASS=false

# 创始人配置
FOUNDER_WECHAT_BIND_KEY=FOUNDER_WECHAT
FOUNDER_WECHAT_OPENID=FOUNDER_OPENID
FOUNDER_ADMIN_USERNAME=FOUNDER_USERNAME
EXPORT_PLATFORM_FOUNDER_ONLY=true

# SSL配置
SSL_PROVIDER=acme
ACME_WEBHOOK_URL=
# 演示域 ACME 彩排（COMM-ARCH-01 / scripts/pilot-acme-ssl-issue.ps1）
# DEMO_HTTPS_DOMAIN=demo.your-pilot-domain.com
# PILOT_TENANT_ID=租户UUID
# AUTH_TOKEN=Bearer <超管JWT>

# 支付配置
PAYMENT_WEBHOOK_SECRET=PAYMENT_SECRET
PAYMENT_STRICT_VERIFY=true

# 中文片出海 / 媒体链（未配置 sidecar 时 API 返回 configured=false，禁止假成功）
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
XFYUN_LFASR_APP_ID=
XFYUN_LFASR_API_KEY=
XFYUN_LFASR_SECRET_KEY=
LINLY_DUBBING_BASE_URL=
YOUDUB_WEBUI_BASE_URL=
V2VT_BASE_URL=
FLY_CUT_EMBED_URL=
OPENCUT_EMBED_URL=
VOZO_API_KEY=