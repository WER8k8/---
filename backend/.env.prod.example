# =============================================================================
# 生产环境配置示例（复制为服务器 .env，勿提交真实密钥）
# =============================================================================

ENVIRONMENT=production
DEBUG=false
OAUTH_DEV_BYPASS=false
MVP_LAUNCH=0

SITE_URL=https://youding.com
FRONTEND_URL=https://admin.youding.com

# 生产必须使用 PostgreSQL
DATABASE_URL=postgresql://user:password@db-host:5432/youding

# RLS 试点（tenant-isolation-rls-pilot-design · 批次 1 安全收口）
# 默认关闭。开启前置条件：① 试点表已有 tenant_id 列且历史数据已回填；
# ② 在真实 PostgreSQL 中执行 alembic upgrade head 创建策略；
# ③ 完成 BaseRepository 集成测试（见设计文档「未验证点」）。
# RLS_PILOT_ENABLED=false
# RLS_PILOT_TABLES=   # 逗号分隔，如 "mcp_servers,plugins"

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET_KEY=
SECRET_KEY=

# 创始人 / 成果保护（SEC-02）
FOUNDER_WECHAT_BIND_KEY=qq979072138
FOUNDER_WECHAT_OPENID=wechat_qq979072138
FOUNDER_ADMIN_USERNAME=qq979072138
EXPORT_PLATFORM_FOUNDER_ONLY=true

# 国际抓取 Webhook（外置 Worker POST）
CRAWL_WEBHOOK_SECRET=

# 可选：每日排名后台线程
# 每日关键词排名后台线程（生产 SEO-04：按需 true 并重启后端）
RANK_SCHEDULER_ENABLED=false

# 商业飞轮
UBRAIN_AUTO_PIPELINE=1

# 摸金校尉 · 生产（详见 deploy/production/env.template）
HERMES_GREEDY_AVATAR_ENABLED=true
HERMES_GREEDY_AUTO_PUBLISH_ENABLED=false
HERMES_GREEDY_PUBLISH_TENANT_ID=
HERMES_GREEDY_BOOTSTRAP_ON_STARTUP=true
HERMES_GREEDY_REVENUE_LOOP_SCHEDULER_ENABLED=true
HERMES_GREEDY_DIGEST_SCHEDULER_ENABLED=true
HERMES_GREEDY_DIGEST_WEBHOOK_URL=
SURVIVAL_WORLDFIRST_WEBHOOK_SECRET=
FEISHU_WEBHOOK_URL=
OPS_CRON_TOKEN=

# AI（商用建议至少一个 Key；MVP 可 MVP_LAUNCH=1）
AI_DEEPSEEK_API_KEY=

# 支付生产
PAYMENT_STRICT_VERIFY=true
PAYMENT_WEBHOOK_SECRET=

# 物流
LOGISTICS_PROVIDER=kuaidi100
KUAIDI100_API_KEY=
KUAIDI100_CUSTOMER=

# SSL（T-P0-11）生产: certbot | acme+ACME_WEBHOOK_URL；演示: dev_local
SSL_PROVIDER=certbot
CERTBOT_EMAIL=
CERTBOT_WEBROOT=/var/www/certbot
# ACME_WEBHOOK_URL=

# =============================================================================
# SEC-03 上线前勾选（运营逐项打勾，勿提交真实值到 Git）
# [ ] JWT_SECRET_KEY / SECRET_KEY ≥32 字符
# [ ] OAUTH_DEV_BYPASS=false
# [ ] DATABASE_URL=postgresql://...
# [ ] REDIS_URL / CELERY_BROKER_URL 已填
# [ ] PAYMENT_WEBHOOK_SECRET 已填
# [ ] CRAWL_WEBHOOK_SECRET 已填
# [ ] MVP_LAUNCH=0（商用）
# [ ] RLS 试点：如启用 RLS_PILOT_ENABLED=true，确认 tenant_id 已回填
#     且 alembic upgrade head 已在真实 PostgreSQL 执行、集成测试通过
# =============================================================================
