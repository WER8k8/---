# =============================================================================
# 生产环境配置示例（复制为服务器 .env，勿提交真实密钥）
# =============================================================================

ENVIRONMENT=production
DEBUG=false
OAUTH_DEV_BYPASS=false
MVP_LAUNCH=0

SITE_URL=https://youding.com
FRONTEND_URL=https://admin.youding.com

# 生产必须使用 PostgreSQL
DATABASE_URL=postgresql://user:password@db-host:5432/youding

# RLS 试点（tenant-isolation-rls-pilot-design · 批次 1 安全收口）
# 默认关闭。开启前置条件：① 试点表已有 tenant_id 列且历史数据已回填；
# ② 在真实 PostgreSQL 中执行 alembic upgrade head 创建策略；
# ③ 完成 BaseRepository 集成测试（见设计文档「未验证点」）。
# RLS_PILOT_ENABLED=false
# RLS_PILOT_TABLES=   # 逗号分隔，如 "mcp_servers,plugins"

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET_KEY=
SECRET_KEY=

# 创始人 / 成果保护（SEC-02）
FOUNDER_WECHAT_BIND_KEY=qq979072138
FOUNDER_WECHAT_OPENID=wechat_qq979072138
FOUNDER_ADMIN_USERNAME=qq979072138
EXPORT_PLATFORM_FOUNDER_ONLY=true

# 国际抓取 Webhook（外置 Worker POST）
CRAWL_WEBHOOK_SECRET=

# 可选：每日排名后台线程
# 每日关键词排名后台线程（生产 SEO-04：按需 true 并重启后端）
RANK_SCHEDULER_ENABLED=false

# 商业飞轮
UBRAIN_AUTO_PIPELINE=1

# 摸金校尉 · 生产（详见 deploy/production/env.template）
HERMES_GREEDY_AVATAR_ENABLED=true
HERMES_GREEDY_AUTO_PUBLISH_ENABLED=false
HERMES_GREEDY_PUBLISH_TENANT_ID=
HERMES_GREEDY_BOOTSTRAP_ON_STARTUP=true
HERMES_GREEDY_REVENUE_LOOP_SCHEDULER_ENABLED=true
HERMES_GREEDY_DIGEST_SCHEDULER_ENABLED=true
HERMES_GREEDY_DIGEST_WEBHOOK_URL=
SURVIVAL_WORLDFIRST_WEBHOOK_SECRET=
FEISHU_WEBHOOK_URL=
OPS_CRON_TOKEN=

# AI（商用建议至少一个 Key；MVP 可 MVP_LAUNCH=1）
AI_DEEPSEEK_API_KEY=

# 支付生产
PAYMENT_STRICT_VERIFY=true
PAYMENT_WEBHOOK_SECRET=

# 物流
LOGISTICS_PROVIDER=kuaidi100
KUAIDI100_API_KEY=
KUAIDI100_CUSTOMER=

# SSL（T-P0-11）生产: certbot | acme+ACME_WEBHOOK_URL；演示: dev_local
SSL_PROVIDER=certbot
CERTBOT_EMAIL=
CERTBOT_WEBROOT=/var/www/certbot
# ACME_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# 平台凭证（获客链路：填哪儿 / 去哪儿申请）
# 机器可读清单：GET /api/v1/seo-matrix/platform-credential-guide
#   回「每个平台要哪些字段 + 申请入口 URL + 当前 env 是否已配（只回布尔，不回值）」
# 三处落点，优先级 configs < cookie < token_data：
#   1) POST/PUT /api/v1/seo-matrix/platform-accounts → 单店专属凭证（含国内 Cookie）
#   2) 本文件（backend/.env）→ 全局通道级密钥
#   3) platform_configs 键值表 → 上述两者都会写入做兜底
# 缺凭证时链路如实返回 PLATFORM_NOT_CONFIGURED，不会假装已发布。
# 以下全部留空占位，真实值只写在服务器 .env，严禁提交进仓库。
# -----------------------------------------------------------------------------
# GSC：console.cloud.google.com 启用 Search Console API → 服务账号 JSON
#      再把服务账号邮箱加为 GSC 资源的「拥有者/用户」，纯 API Key 查不到数据
# GSC_SERVICE_ACCOUNT_JSON=
# GSC_ALLOW_MOCK=false
# 百度：ziyuan.baidu.com 验证站点后取主动推送 token
# BAIDU_SITE_TOKEN=
# Alibaba：i.alibaba.com（卖家后台）/ open.alibaba.com（建应用取 access_token，需 ISV 资质）
# ALIBABA_MEMBER_ID=
# ALIBABA_ACCESS_TOKEN=
# MIC：seller.made-in-china.com 供应商后台接口授权（无自助入口则找客户经理）
# MIC_ACCESS_TOKEN=
# GlobalSources：无公开自助 API，需联系客户经理开通上传接口
# GS_API_KEY=
# 微信公众号：mp.weixin.qq.com 基本配置，并把服务器出口 IP 加入白名单（否则 40164）
# WECHAT_MP_APPID=
# WECHAT_MP_APPSECRET=
# 海外社媒（X/TikTok/LinkedIn/Facebook/Reddit/Medium…）走 AiToEarn，OAuth 在通道侧
# AITOEARN_API_KEY=

# =============================================================================
# SEC-03 上线前勾选（运营逐项打勾，勿提交真实值到 Git）
# [ ] JWT_SECRET_KEY / SECRET_KEY ≥32 字符
# [ ] OAUTH_DEV_BYPASS=false
# [ ] DATABASE_URL=postgresql://...
# [ ] REDIS_URL / CELERY_BROKER_URL 已填
# [ ] PAYMENT_WEBHOOK_SECRET 已填
# [ ] CRAWL_WEBHOOK_SECRET 已填
# [ ] MVP_LAUNCH=0（商用）
# [ ] RLS 试点：如启用 RLS_PILOT_ENABLED=true，确认 tenant_id 已回填
#     且 alembic upgrade head 已在真实 PostgreSQL 执行、集成测试通过
# [ ] 谷歌收录真值：GSC_SERVICE_ACCOUNT_JSON 对应的服务账号邮箱已被加为 GSC 资源用户
#     （只填 GSC_API_KEY 不算配置完成，数据接口不接受纯 API Key）
# [ ] GSC_ALLOW_MOCK=false（生产禁止 mock 冒充真实排名）
# [ ] 海外 B2B（Alibaba/MIC/GlobalSources）未拿到接口权限时，链路停在
#     PLATFORM_NOT_CONFIGURED 属预期行为，不得为消除报错而伪造成功回执
# =============================================================================
