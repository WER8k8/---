{
  "contract_id": "SITE-DESIGN-01",
  "version": "2026-06-16",
  "status": "active",
  "summary": "租户独立站默认标准 L-Pro：ydalison 信任叙事 + T-Global 产品中心能力；Hermes 只填槽不造版式。",
  "target_model": {
    "id": "L-Pro",
    "label": "ydalison + T-Global 产品中心（合并默认）",
    "baseline_urls": [
      "https://www.ydalison.com/",
      "https://en.ydalison.com/",
      "https://www.t-global.com/"
    ],
    "upgrade_tier": {
      "id": "L-Plus",
      "label": "T-Global 全量（区域站、计算器、GDPR 中心等）",
      "out_of_scope_v1": [
        "thermal_calculator",
        "full_gdpr_cookie_center",
        "8_plus_regional_sites",
        "ecommerce_checkout"
      ]
    }
  },
  "page_map": [
    { "path": "/", "role": "home", "from": "ydalison+tglobal" },
    { "path": "/about", "role": "trust_factory_narrative", "from": "ydalison" },
    { "path": "/products", "role": "product_hub", "from": "tglobal" },
    { "path": "/products/[category]", "role": "category_list_filter", "from": "tglobal" },
    { "path": "/products/[sku]", "role": "product_detail_specs_inquiry", "from": "tglobal" },
    { "path": "/solutions", "role": "applications_by_industry", "from": "ydalison" },
    { "path": "/downloads", "role": "brochures_specs_pdfs", "from": "tglobal" },
    { "path": "/contact", "role": "multi_channel_inquiry", "from": "ydalison+tglobal" }
  ],
  "capability_matrix": {
    "from_ydalison": [
      "about_since_year_factory_story",
      "applications_by_industry",
      "professional_imagery",
      "cn_en_primary_locales",
      "multi_line_contact"
    ],
    "from_tglobal": [
      "multi_level_products_nav",
      "list_detail_filter_compare",
      "inquiry_compare_cart_hooks",
      "download_center"
    ],
    "hermes_scope": {
      "in_scope": [
        "template_selection",
        "slot_copy_fill",
        "seo_meta",
        "cta_inquiry_hooks",
        "product_image_binding"
      ],
      "out_of_scope": [
        "layout_generation_from_scratch",
        "grapesjs_as_default_public_face",
        "claim_ecc_generates_professional_sites"
      ]
    }
  },
  "publish_gate": {
    "description": "未满足则禁止对外宣称已上线 / success 终态",
    "required": [
      "premium_template_id_bound",
      "min_product_count_with_images",
      "min_spec_fields_per_sku",
      "contact_channel_at_least_one",
      "about_page_non_empty",
      "no_stub_probe_mode_in_production"
    ],
    "thresholds": {
      "min_products_with_images": 3,
      "min_spec_fields_per_sku": 3
    },
    "validator_scripts": [
      "scripts/validate-no-fake-delivery.py",
      "scripts/validate-site-l-pro-publish.py",
      "scripts/validate-site-design-w3.py"
    ]
  },
  "multilingual": {
    "tier1_core": {
      "count": 12,
      "source": "backend/app/services/im_locale_service.py SUPPORTED_LANGUAGES",
      "policy": "ai_plus_glossary_human_review_for_marketing",
      "spec_tables_locked": true
    },
    "tier2_optional": {
      "label": "more_languages_auto_translate_widget",
      "policy": "marketing_text_only",
      "disclaimer": "technical_specs_in_english_or_source_locale"
    },
    "tier3_l_plus": {
      "label": "regional_urls_human_review",
      "reference": "t-global.com regional sites"
    }
  },
  "implementation_waves": [
    {
      "wave": "W0",
