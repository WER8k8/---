# =============================================================================
# 优丁建材 — 生产环境配置示例（主站商用 MVP）
# 复制为 .env.prod 后填写，勿提交真实密钥到 Git
# =============================================================================

# ── 域名 ──
DOMAIN=www.youdingjiancai.com
FRONTEND_URL=https://www.youdingjiancai.com

# ── 运行模式 ──
ENVIRONMENT=production
DEBUG=false
# 主站 MVP：无 AI Key 也可启动（AI/AccioWork 二期）；正式全量商用请去掉并配置 AI Key
MVP_LAUNCH=1

# 创始人绑死（你的微信号）
FOUNDER_WECHAT_BIND_KEY=qq979072138
FOUNDER_WECHAT_OPENID=wechat_qq979072138
FOUNDER_ADMIN_USERNAME=qq979072138
FOUNDER_DEBUG_IPS=

# ── 数据库（PostgreSQL）──
DB_NAME=youding_prod
DB_USER=youding_admin
DB_PASSWORD=
# Compose 内 backend 使用 DATABASE_URL；单机部署可同样设置：
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/youding_prod

# ── RLS 试点（默认关闭；开启前置条件见 backend/.env.example 同名段落）──
# RLS_PILOT_ENABLED=false
# RLS_PILOT_TABLES=

# ── Redis ──
REDIS_PASSWORD=
REDIS_ENABLED=true

# ── 密钥（必须 ≥32 字符强随机）──
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
SECRET_KEY=

# ── 安全 / 支付 / SSL ──
PAYMENT_STRICT_VERIFY=1
SSL_PROVIDER=certbot
CERTBOT_EMAIL=ops@youdingjiancai.com
OAUTH_DEV_BYPASS=0

# ── MinIO 对象存储 ──
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=minio:9000

# ── Grafana（可选）──
GRAFANA_PASSWORD=

# ── AI（二期；MVP_LAUNCH=1 时可留空）──
AI_DEEPSEEK_API_KEY=
AI_NVIDIA_API_KEY=
AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── 邮件（询盘通知）──
SMTP_SERVER=smtp.qiye.aliyun.com
SMTP_PORT=587
SMTP_USERNAME=noreply@youdingjiancai.com
SMTP_PASSWORD=
FROM_EMAIL=noreply@youdingjiancai.com

# ── 日志 / 限流 ──
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_MAX_REQUESTS=60

# ── Nuxt 租户站（构建时注入；多租户优先子域名，单租户可设 ID）──
NUXT_PUBLIC_API_BASE=https://www.youdingjiancai.com/api/v1
NUXT_PUBLIC_SITE_URL=https://www.youdingjiancai.com
NUXT_PUBLIC_UNIFIED_ADMIN_LOGIN_URL=https://admin.youdingjiancai.com/login
# NUXT_PUBLIC_TENANT_ID=
# NUXT_PUBLIC_AGENT_NODE_ID=
