# ============================================================
# YouDing 优丁 B2B 外贸 SaaS — 生产环境配置模板
# ============================================================
# 使用方法:
#   1. 复制本文件为 .env.prod: cp .env.prod.example .env.prod
#   2. 修改填入实际生产凭证（特别是带 CHANGEME_ 标记的项）
#   3. 执行启动: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# 警告:
#   .env.prod 包含敏感凭证，已被 .gitignore 忽略，严禁提交进 Git 代码仓库！
# ============================================================

# ── 1. 域名与基础环境 ──────────────────────────────────────────
# 生产主域名（勿带 http/https 前缀）
DOMAIN=youding.com
ENVIRONMENT=production
DEBUG=false
# 0 = 真实生产模式；1 = MVP演示降级模式
MVP_LAUNCH=0
# 支付严格核验
PAYMENT_STRICT_VERIFY=1

# ── 2. 数据库配置 (PostgreSQL 15 + pgvector) ───────────────────
DB_NAME=youding_prod
DB_USER=youding_admin
# 请使用强密码 (例如: openssl rand -base64 24)
DB_PASSWORD=CHANGEME_STRONG_POSTGRES_PASSWORD

# ── 3. Redis 缓存与 Celery 队列 (Redis 7) ──────────────────────
# Redis 生产密码
REDIS_PASSWORD=CHANGEME_STRONG_REDIS_PASSWORD

# ── 4. 平台核心安全密钥 ─────────────────────────────────────────
# JWT 与会话加密密钥 (生成命令: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=CHANGEME_GENERATE_RANDOM_64_CHAR_HEX_KEY
SECRET_KEY=CHANGEME_GENERATE_RANDOM_64_CHAR_HEX_KEY

# ── 5. SSL / TLS 证书配置 ──────────────────────────────────────
# certbot 或 custom
SSL_PROVIDER=certbot
CERTBOT_EMAIL=admin@youding.com

# ── 6. 外贸真实出站通道 (获客与7步履约核心) ─────────────────────
# 6.1 SMTP 邮件出站 (商机邮件触达 / outreach.email)
SMTP_SERVER=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=outreach@youding.com
SMTP_PASSWORD=CHANGEME_SMTP_APP_PASSWORD
FROM_EMAIL=outreach@youding.com

# 6.2 WhatsApp Business Cloud API (outreach.whatsapp / 7步履约)
# 获取地址: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── 7. 大模型与 AI 引擎配置 ────────────────────────────────────
# 优选主通道 (OpenAI / DeepSeek / NVIDIA NIM / 聚合网关)
AI_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_FALLBACK_MODEL=gpt-4o-mini

# 备用引擎
AI_DEEPSEEK_API_KEY=
AI_NVIDIA_API_KEY=

# ── 8. MinIO 对象存储 (S3 兼容，媒体资源与导件存储) ───────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGEME_MINIO_ADMIN_USER
MINIO_SECRET_KEY=CHANGEME_MINIO_ADMIN_PASSWORD
MINIO_SECURE=false

# ── 9. 运维与告警通知 ──────────────────────────────────────────
# 飞书机器人 Webhook (群机器人告警)
FEISHU_WEBHOOK_URL=
HERMES_OPS_AUTOPILOT_ENABLED=true
RANK_SCHEDULER_ENABLED=true
DEERFLOW_SCHEDULER_ENABLED=true
