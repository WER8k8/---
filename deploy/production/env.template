#       deploy/docs/USER-ACTION-ANALYTICS-SIDECAR-DEPLOY.md
# 本地一键：docker compose -f deploy/examples/sidecars-compose.yml up -d
# =============================================================================
AI_FIND_CUSTOMER_URL=
AI_FIND_CUSTOMER_TOKEN=
HEADLESS_PROBE_SIDECAR_URL=
HEADLESS_PROBE_SIDECAR_TOKEN=
HEADLESS_PROBE_ALLOW_STUB=0
ECOMMERCE_CRAWLERS_URL=
ECOMMERCE_CRAWLERS_TOKEN=
ECOMMERCE_SOCIAL_SPIDERS_ENABLED=0
USER_ACTION_ANALYTICS_URL=
USER_ACTION_ANALYTICS_TOKEN=
USER_ACTION_ANALYTICS_ALLOW_STUB=0
USER_ACTION_ANALYTICS_MYSQL_DSN=
USER_ACTION_MODULE_ENABLE_SESSION_ANALYSIS=0

# 挣钱大赛：GET /api/v1/hermes/greedy/contest/endurance
# 专家记忆：GET /api/v1/hermes/greedy/memory/roles/{role_id}

