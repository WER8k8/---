# =============================================================================
# 生产环境配置模板 — 仅用于服务器部署
# 复制到服务器后重命名为 .env；勿在 Desktop/上线网站 本地开发目录填写真实值
# 分项说明见：deploy/production/README.md
# =============================================================================

ENVIRONMENT=production
DEBUG=false
OAUTH_DEV_BYPASS=false
MVP_LAUNCH=0

SITE_URL=https://youding.com
FRONTEND_URL=https://admin.youding.com

DATABASE_URL=postgresql://user:password@db-host:5432/youding

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET_KEY=
SECRET_KEY=

FOUNDER_WECHAT_BIND_KEY=
FOUNDER_WECHAT_OPENID=
FOUNDER_ADMIN_USERNAME=
EXPORT_PLATFORM_FOUNDER_ONLY=true

CRAWL_WEBHOOK_SECRET=
RANK_SCHEDULER_ENABLED=false
UBRAIN_AUTO_PIPELINE=1

# Hermes / DeerFlow / n8n（Sprint 2）
HERMES_OPS_AUTOPILOT_ENABLED=true
HERMES_CONTINUOUS_ITERATION_ENABLED=true
# GitHub 生态侦察（研究员代搜，可选 GITHUB_TOKEN 提高 API 限额）
# GITHUB_ECOSYSTEM_SCOUT_ENABLED=true
# GITHUB_TOKEN=
FEISHU_WEBHOOK_URL=
DEERFLOW_SCHEDULER_ENABLED=true
DEERFLOW_TENANT_CELERY_ENABLED=true
N8N_WEBHOOK_SECRET=
# 可选 n8n 基址（foreign-trade-stack.compose.yml）
# N8N_WEBHOOK_URL=https://n8n.example.com/

# Sprint 4：收录探测与 Rank Guard RUM 阈值
INCLUSION_PROBE_REAL_ENABLED=false
RUM_LCP_MS=2000
RUM_INP_MS=150
RUM_ERROR_RATE=0.005

AI_DEEPSEEK_API_KEY=
AI_NVIDIA_API_KEY=
# 英伟达免费通道模型探测：ENVIRONMENT=production 时后端自动开启（1:00/12:00/20:00 北京时间），无需单独开关
# 若需关闭：NVIDIA_CUSTOMER_PROBE_SCHEDULER_ENABLED=false

PAYMENT_STRICT_VERIFY=true
PAYMENT_WEBHOOK_SECRET=

LOGISTICS_PROVIDER=kuaidi100
KUAIDI100_API_KEY=
KUAIDI100_CUSTOMER=

SSL_PROVIDER=certbot
CERTBOT_EMAIL=
CERTBOT_WEBROOT=/var/www/certbot

# 询盘 IM 渠道（七步⑤ · MOD-02 — 生产填写，勿提交真实值）
INQUIRY_WEBHOOK_SECRET=
SOCIAL_INTERACTION_WEBHOOK_SECRET=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
# 客户销售 UserID 在租户后台配置，勿写平台 .env
# WECOM_PUSH_TO_USERIDS=  # 仅本地开发兜底
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
PUBLIC_API_BASE=
# ITER-03b · 抖音评论 Inbox 目录（SAU/人工导出 JSON 落盘）与 AiToEarn 拉评路径
DOUYIN_COMMENT_INBOX_DIR=
AITOEARN_COMMENT_LIST_PATH=/plugin/comment/list

# 产品图片空间 — 国内七牛 / 海外 R2（平台一次性配置，客户无需自开；见 docs/PLATFORM-STORAGE-SETUP.md）
FILE_STORAGE_DEFAULT_REGION=cn
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_PUBLIC_BASE_URL=
QINIU_UPLOAD_HOST=https://up-z1.qiniup.com

# 多媒体工厂 · 云存储（酷播 L1 + R2 L2，棱束链可选灾备；见 docs/MEDIA-FACTORY-CLOUD-STORAGE.md）
MEDIA_CLOUD_PLAY_PRIMARY=cuplayer
MEDIA_CLOUD_ARCHIVE=r2
MEDIA_CLOUD_BACKUP=lenslink
MEDIA_CLOUD_UPLOAD_ENABLED=true
MEDIA_CUPLAYER_WRITETOKEN=
MEDIA_CUPLAYER_SECRETKEY=
MEDIA_CUPLAYER_USERID=
MEDIA_CUPLAYER_READTOKEN=
MEDIA_CUPLAYER_CATAID=1
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_BUCKET=
MEDIA_R2_PUBLIC_BASE_URL=
MEDIA_R2_CDN_BASE_URL=
MEDIA_R2_PRESIGN_SECONDS=604800
MEDIA_LENSLINK_ENDPOINT=
MEDIA_LENSLINK_ACCESS_KEY=
MEDIA_LENSLINK_SECRET_KEY=
MEDIA_LENSLINK_BUCKET=
MEDIA_LENSLINK_PUBLIC_BASE_URL=
MEDIA_LENSLINK_SECURE=true

# Hermes × agency-orchestrator LLM（10 provider / 7 免 Key，见 GET /api/v1/hermes/agency/providers）
HERMES_AGENCY_LLM_ENABLED=true
HERMES_AGENCY_DEFAULT_PROVIDER=
# 生产建议 API 优先；本机开发可 hermes-cli,ollama,gemini-cli,deepseek,...
HERMES_AGENCY_PROVIDER_CHAIN=deepseek,ollama,openai,hermes-cli,gemini-cli,claude-code
HERMES_AGENCY_CLI_TIMEOUT_SEC=600
HERMES_AGENCY_OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 部署后自动起 Ollama Docker 侧车（cloud-post-deploy / bootstrap）
HERMES_AGENCY_AUTO_DOCKER_OLLAMA=true
HERMES_AGENCY_AUTO_NPM_INSTALL=false
# Hermes 7×24 巡站 + 自愈（生产默认开启，见 site_patrol_scheduler）
HERMES_SITE_PATROL_SCHEDULER_ENABLED=true
HERMES_SITE_PATROL_INTERVAL_MINUTES=15
HERMES_AUTO_REMEDIATION_ENABLED=true
HERMES_OPS_AUTOPILOT_ENABLED=true
HERMES_ALERT_WEBHOOK_URL=
# 可选 API Key（与 AI_* 共用）：DEEPSEEK_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY

# =============================================================================
# 财迷疯 · 平台生存基金（仅超管 · 万里汇 WorldFirst 主通道）
# 主体：有限责任公司 · 与 L4 租户微信/支付宝商户号完全隔离
# =============================================================================
PLATFORM_SURVIVAL_ENABLED=true
PLATFORM_SURVIVAL_PRIMARY_RAIL=worldfirst
PLATFORM_SURVIVAL_DAILY_TARGET_CNY_MINOR=100000
# 万里汇 API/Webhook（开通后从 WF 商户后台获取；未接 webhook 前用手工入账 API）
SURVIVAL_WORLDFIRST_CLIENT_ID=
SURVIVAL_WORLDFIRST_WEBHOOK_SECRET=
# 入账 API：POST /api/v1/hermes/ops/survival/worldfirst/record
# 禁止：勿将万里汇配置写入 PaymentChannel 的 wechat/alipay 行

# 财迷疯 · 摸金校尉（greedy_avatar_constitution — 与 SaaS 维护宪法隔离）
HERMES_GREEDY_AVATAR_ENABLED=true
# 设 true 时 L4 尝试 platform survival 矩阵发布计划（默认 false）
HERMES_GREEDY_AUTO_PUBLISH_ENABLED=false
HERMES_GREEDY_DIGEST_POLL_MINUTES=30
HERMES_GREEDY_DIGEST_WEEKDAY=0
HERMES_GREEDY_DIGEST_HOUR=9
HERMES_GREEDY_DIGEST_TIMEZONE=Asia/Shanghai
HERMES_GREEDY_DIGEST_WEBHOOK_URL=
# 摸金 L4 审核通过后创建 PublishTask 的租户（空则 bootstrap platform-survival.ops）
HERMES_GREEDY_PUBLISH_TENANT_ID=
# 生产启动时自动 bootstrap 自营租户+占位账号（默认 production 开）
HERMES_GREEDY_BOOTSTRAP_ON_STARTUP=
# 生产推荐显式开启（空=production 默认 true）：
HERMES_GREEDY_REVENUE_LOOP_SCHEDULER_ENABLED=true
HERMES_GREEDY_DIGEST_SCHEDULER_ENABLED=true
# 外部 cron token（搞钱闭环 / 运维）
OPS_CRON_TOKEN=
# 飞书（Survival 周报 + 运维告警）
FEISHU_WEBHOOK_URL=

# =============================================================================
